  <script>
    const $=id=>document.getElementById(id);
    let records=[],activeStudent=null,selectedMaterial=null,selectedTask=null,selectedClass="all";
    const msg=(id,text,error=false)=>{const el=$(id);el.textContent=text;el.className="mt-4 text-sm font-semibold "+(error?"text-[#b23b32]":"text-[#26735e]")};
    const rows=type=>records.filter(r=>r.record_type===type).sort((a,b)=>new Date(b.timestamp)-new Date(a.timestamp));
    const profiles=()=>rows("profile");
    const linkOK=v=>{try{return ["https:","http:"].includes(new URL(v).protocol)}catch{return false}};
    const dateText=new Date().toLocaleDateString("id-ID",{weekday:"long",day:"numeric",month:"long",year:"numeric"});
    $("attendance-date").textContent=dateText;

    function openStudentPage(id){
      document.querySelectorAll(".student-page").forEach(page=>page.classList.toggle("is-active",page.id===id));
      document.querySelectorAll("[data-student-page]").forEach(button=>{
        const active=button.dataset.studentPage===id;
        button.classList.toggle("is-active",active);
        button.setAttribute("aria-selected",String(active));
      });
    }
    function showDashboard(role){
      $("access-area").classList.add("hidden");
      $("student-dashboard").classList.toggle("is-active",role==="student");
      $("teacher-dashboard").classList.toggle("is-active",role==="teacher");
      const profile=$("header-profile");
      profile.textContent=role==="student"?"Murid · "+activeStudent.student_name:"Guru · Harno Smamsa";
      profile.classList.remove("hidden");
      $("class-badge").textContent=role==="student"?"Kelas "+activeStudent.class_name:"";
      $("class-badge").classList.toggle("hidden",role!=="student");
      $("header-teacher-exit").classList.toggle("hidden",role!=="teacher");
      if(role==="student")openStudentPage("student-home-page");
    }
    function exitDashboard(){
      activeStudent=null;
      $("header-profile").classList.add("hidden");
      $("header-profile").textContent="";
      $("header-teacher-exit").classList.add("hidden");
      $("access-area").classList.remove("hidden");
      $("student-dashboard").classList.remove("is-active");
      $("teacher-dashboard").classList.remove("is-active");
      $("register-form").reset();$("login-form").reset();$("teacher-form").reset();msg("access-message","");
    }
    function makeRecord(type,values={}){
      return {record_type:type,student_name:"",role:"guru",status:"Aktif",title:"",description:"",score:0,timestamp:new Date().toISOString(),email:"",class_name:"",link_url:"",task_id:"",submission_text:"",...values};
    }
    function renderContent(listId,items,emptyId,teacher=false){
      const list=$(listId),current=new Map([...list.children].map(x=>[x.dataset.id,x]));
      items.forEach(record=>{
        let el=current.get(record.__backendId);
        if(!el){el=$("content-row-template").content.cloneNode(true).firstElementChild;el.dataset.id=record.__backendId;list.appendChild(el);lucide.createIcons()}
        el.querySelector('[data-template-id="content-row-title"]').textContent=record.title;
        el.querySelector('[data-template-id="content-row-description"]').textContent=record.description;
        const a=el.querySelector(".link-action"),valid=linkOK(record.link_url);
        el.classList.toggle("has-link",valid);if(valid)a.href=record.link_url;
        el.querySelector(".edit-content").classList.toggle("hidden",!teacher);
        el.querySelector(".delete-content").classList.toggle("hidden",!teacher);
        current.delete(record.__backendId);
      });
      current.forEach(el=>el.remove());$(emptyId).classList.toggle("hidden",items.length>0);
    }
    function renderSimple(listId,items,templateId,emptyId,fill){
      const list=$(listId),current=new Map([...list.children].map(x=>[x.dataset.id,x]));
      items.forEach(record=>{
        let el=current.get(record.__backendId);
        if(!el){el=$(templateId).content.cloneNode(true).firstElementChild;el.dataset.id=record.__backendId;list.appendChild(el)}
        fill(el,record);current.delete(record.__backendId);
      });
      current.forEach(el=>el.remove());$(emptyId).classList.toggle("hidden",items.length>0);
    }
    function renderSubmissions(listId,items,emptyId,student=false){
      const list=$(listId),current=new Map([...list.children].map(x=>[x.dataset.id,x]));
      items.forEach(record=>{
        let el=current.get(record.__backendId);
        if(!el){el=$("submission-row-template").content.cloneNode(true).firstElementChild;el.dataset.id=record.__backendId;list.appendChild(el);lucide.createIcons()}
        el.querySelector('[data-template-id="submission-row-name"]').textContent=student?"Tugas terkumpul":record.student_name+" · "+record.class_name;
        el.querySelector('[data-template-id="submission-row-task"]').textContent=record.title;
        el.querySelector('[data-template-id="submission-row-status"]').textContent=record.status||"Terkumpul";
        el.querySelector(".submission-answer").textContent=record.submission_text||"Tidak ada jawaban tertulis.";
        const submissionLink=el.querySelector(".submission-link"),hasSubmissionLink=linkOK(record.link_url);
        submissionLink.classList.toggle("hidden",!hasSubmissionLink);submissionLink.classList.toggle("inline-flex",hasSubmissionLink);if(hasSubmissionLink)submissionLink.href=record.link_url;
        el.querySelector(".submission-score").textContent=record.status==="Dinilai"?"Nilai: "+record.score+"/100":"";
        el.querySelector(".teacher-grade").classList.toggle("hidden",student);
        el.querySelector(".score-input").value=record.score||"";
        current.delete(record.__backendId);
      });
      current.forEach(el=>el.remove());$(emptyId).classList.toggle("hidden",items.length>0);
    }
    function render(data){
      records=data;
      const classMatch=r=>selectedClass==="all"||r.class_name===selectedClass;
      const students=profiles().filter(classMatch),materials=rows("material"),tasks=rows("task"),attendance=rows("attendance").filter(classMatch),submissions=rows("submission").filter(classMatch);
      $("student-count").textContent=students.length;$("present-count").textContent=attendance.length;$("material-count").textContent=materials.length;$("task-count").textContent=tasks.length;$("submission-count").textContent=submissions.length;
      renderContent("student-material-list",materials,"student-material-empty");
      renderContent("student-task-list",tasks,"student-task-empty");
      renderContent("teacher-material-list",materials,"teacher-material-empty",true);
      renderContent("teacher-task-list",tasks,"teacher-task-empty",true);
      renderSimple("teacher-student-list",students,"student-row-template","teacher-student-empty",(el,r)=>{el.querySelector('[data-template-id="student-row-name"]').textContent=r.student_name;el.querySelector('[data-template-id="student-row-detail"]').textContent=r.class_name+" · "+r.email});
      renderSimple("teacher-attendance-list",attendance,"attendance-row-template","teacher-attendance-empty",(el,r)=>{el.querySelector('[data-template-id="attendance-row-name"]').textContent=r.student_name;el.querySelector('[data-template-id="attendance-row-time"]').textContent="Jam presensi: "+new Date(r.timestamp).toLocaleString("id-ID",{dateStyle:"medium",timeStyle:"short"})+" · "+r.class_name;el.querySelector('[data-template-id="attendance-row-status"]').textContent=r.status});
      renderSubmissions("teacher-submission-list",submissions,"teacher-submission-empty");
      const select=$("submission-task"),old=select.value;select.innerHTML='<option value="">Pilih tugas</option>';
      tasks.forEach(t=>{const o=document.createElement("option");o.value=t.__backendId;o.textContent=t.title;select.appendChild(o)});select.value=old;updateSubmissionStatus();
      if(activeStudent){
        $("student-welcome").textContent="Selamat datang, "+activeStudent.student_name+" · "+activeStudent.class_name;
        const studentAttendance=attendance.filter(a=>a.email===activeStudent.email);
        document.querySelector(".attendance-widget").classList.toggle("is-present",studentAttendance.length>0);
        $("student-attendance-history").textContent=studentAttendance.length?"Presensi terakhir: "+new Date(studentAttendance[0].timestamp).toLocaleString("id-ID",{dateStyle:"medium",timeStyle:"short"}):"Belum ada riwayat presensi.";
        renderSubmissions("student-submission-list",submissions.filter(s=>s.email===activeStudent.email),"student-submission-empty",true);
      }
    }
    function updateSubmissionStatus(){
      const taskId=$("submission-task").value,status=$("submission-status"),value=$("submission-status-value");
      if(!taskId||!activeStudent){status.classList.add("hidden");value.textContent="";return}
      const submission=records.find(r=>r.record_type==="submission"&&r.task_id===taskId&&r.email===activeStudent.email);
      status.classList.remove("hidden");
      value.textContent=submission?(submission.status==="Dinilai"?"Sudah dikumpulkan · Nilai: "+submission.score+"/100":"Sudah dikumpulkan · Nilai belum diberikan"):"Belum dikumpulkan";
      value.className="ml-1 "+(submission?(submission.status==="Dinilai"?"text-[#6b4ca2]":"text-[#26735e]"):"text-[#936b09]");
    }
    const handler={onDataChanged:data=>render(data)};
    async function init(){const result=await window.dataSdk.init(handler);if(!result.isOk)msg("access-message","Data kelas belum dapat dimuat. Silakan coba lagi.",true)}

    document.querySelectorAll("[data-role]").forEach(b=>b.addEventListener("click",()=>{const student=b.dataset.role==="student";document.querySelectorAll("[data-role]").forEach(x=>{x.classList.toggle("is-active",x===b);x.setAttribute("aria-pressed",String(x===b))});$("student-access").classList.toggle("is-active",student);$("teacher-form").classList.toggle("is-active",!student)}));
    function switchForm(login){$("register-form").classList.toggle("hidden",login);$("login-form").classList.toggle("hidden",!login);$("register-switch").classList.toggle("bg-[#102b46]",!login);$("login-switch").classList.toggle("bg-[#102b46]",login);$("register-switch").classList.toggle("text-white",!login);$("login-switch").classList.toggle("text-white",login)}
    $("register-switch").addEventListener("click",()=>switchForm(false));$("login-switch").addEventListener("click",()=>switchForm(true));
    document.querySelectorAll("[data-student-page]").forEach(b=>b.addEventListener("click",()=>openStudentPage(b.dataset.studentPage)));
    document.querySelectorAll("[data-panel]").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll("[data-panel]").forEach(x=>x.classList.toggle("is-active",x===b));document.querySelectorAll(".teacher-panel").forEach(x=>x.classList.toggle("is-active",x.id===b.dataset.panel))}));

    $("register-form").addEventListener("submit",async e=>{e.preventDefault();const name=$("register-name").value.trim(),className=$("register-class").value,email=$("register-email").value.trim().toLowerCase();if(!name||!className||!email)return msg("access-message","Lengkapi nama, kelas, dan email.",true);if(profiles().some(p=>p.email.toLowerCase()===email))return msg("access-message","Email ini sudah terdaftar. Silakan masuk.",true);const b=$("register-submit");b.disabled=true;const result=await window.dataSdk.create(makeRecord("profile",{student_name:name,role:"murid",status:"Terdaftar",email,class_name:className}));b.disabled=false;if(!result.isOk)return msg("access-message","Pendaftaran belum dapat disimpan.",true);activeStudent={student_name:name,email,class_name:className};showDashboard("student")});
    $("login-form").addEventListener("submit",e=>{e.preventDefault();const email=$("login-email").value.trim().toLowerCase(),found=profiles().find(p=>p.email.toLowerCase()===email);if(!found)return msg("access-message","Email belum terdaftar. Silakan daftar terlebih dahulu.",true);activeStudent=found;showDashboard("student")});
    $("teacher-form").addEventListener("submit",e=>{e.preventDefault();const v=$("teacher-name").value.trim().toLowerCase();if(v!=="adminik"&&v!=="guru")return msg("access-message","Gunakan akses guru yang sesuai.",true);showDashboard("teacher")});
    $("attendance-button").addEventListener("click",async()=>{if(!activeStudent)return;const b=$("attendance-button");b.disabled=true;const r=await window.dataSdk.create(makeRecord("attendance",{student_name:activeStudent.student_name,role:"murid",status:"Hadir",email:activeStudent.email,class_name:activeStudent.class_name}));b.disabled=false;if(!r.isOk)msg("access-message","Presensi belum dapat disimpan.",true)});
    async function saveContent(type,selected){const title=$(type+"-title").value.trim(),description=$(type+"-description").value.trim(),link=$(type+"-link").value.trim();if(!title||!description)return msg("teacher-message","Lengkapi judul dan deskripsi.",true);if(link&&!linkOK(link))return msg("teacher-message","Gunakan tautan http:// atau https:// yang valid.",true);const b=$(type+"-save");b.disabled=true;const base=makeRecord(type,{title,description,link_url:link});const r=selected?await window.dataSdk.update({...selected,...base}):await window.dataSdk.create(base);b.disabled=false;if(!r.isOk)return msg("teacher-message","Data belum dapat disimpan.",true);$(type+"-form").reset();if(type==="material")selectedMaterial=null;else selectedTask=null;msg("teacher-message","Data berhasil disimpan.") }
    $("material-form").addEventListener("submit",e=>{e.preventDefault();saveContent("material",selectedMaterial)});$("task-form").addEventListener("submit",e=>{e.preventDefault();saveContent("task",selectedTask)});
    $("submission-form").addEventListener("submit",async e=>{e.preventDefault();const task=records.find(r=>r.__backendId===$("submission-task").value),text=$("submission-text").value.trim(),link=$("submission-link").value.trim();if(!task||!text)return msg("submission-message","Pilih tugas dan tuliskan jawaban.",true);if(link&&!linkOK(link))return msg("submission-message","Gunakan tautan valid.",true);const old=records.find(r=>r.record_type==="submission"&&r.task_id===task.__backendId&&r.email===activeStudent.email),b=$("submission-save");b.disabled=true;const base=makeRecord("submission",{student_name:activeStudent.student_name,role:"murid",status:old?.status==="Dinilai"?"Dinilai":"Terkumpul",title:task.title,email:activeStudent.email,class_name:activeStudent.class_name,task_id:task.__backendId,link_url:link,submission_text:text,score:old?.status==="Dinilai"?old.score:0});const r=old?await window.dataSdk.update({...old,...base}):await window.dataSdk.create(base);b.disabled=false;if(!r.isOk)return msg("submission-message","Pengumpulan belum dapat disimpan.",true);$("submission-form").reset();msg("submission-message","Tugas berhasil dikumpulkan.")});
    document.addEventListener("click",async e=>{const row=e.target.closest("[data-id]"),edit=e.target.closest(".edit-content"),del=e.target.closest(".delete-content"),score=e.target.closest(".save-score");if(edit&&row){const r=records.find(x=>x.__backendId===row.dataset.id);if(r.record_type==="material"){selectedMaterial=r;$("material-title").value=r.title;$("material-description").value=r.description;$("material-link").value=r.link_url||""}else{selectedTask=r;$("task-title").value=r.title;$("task-description").value=r.description;$("task-link").value=r.link_url||""}msg("teacher-message","Data dipilih. Perbarui formulir lalu simpan.")}if(del&&row){if(del.dataset.ready==="yes"){const r=records.find(x=>x.__backendId===row.dataset.id);await window.dataSdk.delete(r)}else{del.dataset.ready="yes";msg("teacher-message","Klik lagi ikon hapus untuk menghapus data.");setTimeout(()=>del.dataset.ready="",2200)}}if(score&&row){const r=records.find(x=>x.__backendId===row.dataset.id),n=Number(row.querySelector(".score-input").value);if(!Number.isFinite(n)||n<0||n>100)return msg("teacher-message","Nilai harus 0 sampai 100.",true);score.disabled=true;const out=await window.dataSdk.update({...r,score:n,status:"Dinilai",timestamp:new Date().toISOString()});score.disabled=false;msg("teacher-message",out.isOk?"Nilai berhasil disimpan.":"Nilai belum dapat disimpan.",!out.isOk)}});

    $("submission-task").addEventListener("change",updateSubmissionStatus);
    $("teacher-class-filter").addEventListener("change",e=>{selectedClass=e.target.value;render(records)});
    $("sync-data").addEventListener("click",async()=>{const b=$("sync-data");b.disabled=true;b.querySelector('[data-template-id="teacher-sync-data"]').classList.add("hidden");b.querySelector('[data-template-id="teacher-sync-loading"]').classList.remove("hidden");const result=await window.dataSdk.init(handler);b.disabled=false;b.querySelector('[data-template-id="teacher-sync-loading"]').classList.add("hidden");b.querySelector('[data-template-id="teacher-sync-data"]').classList.remove("hidden");msg("teacher-message",result.isOk?"Database berhasil disinkronkan.":"Database belum dapat disinkronkan.",!result.isOk)});
    $("download-data").addEventListener("click",()=>{const cols=["record_type","student_name","role","status","title","description","score","timestamp","email","class_name","link_url","task_id","submission_text"];const q=v=>'"'+String(v??"").replace(/"/g,'""')+'"';const csv=[cols.join(","),...records.map(r=>cols.map(c=>q(r[c])).join(","))].join("\n");const a=document.createElement("a");a.href=URL.createObjectURL(new Blob(["\uFEFF"+csv],{type:"text/csv;charset=utf-8"}));a.download="lms-harno-data.csv";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)});
    $("student-exit").addEventListener("click",exitDashboard);$("header-teacher-exit").addEventListener("click",exitDashboard);
    lucide.createIcons();init();
  </script>
 </body>
</html>
