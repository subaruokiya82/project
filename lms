     </div><span data-template-id="submission-row-status" class="canva-tag rounded-full bg-[#e9f0ff] px-3 py-1 text-xs font-bold text-[#3866a8]"></span>
    </div>
    <p class="submission-answer mt-3 text-sm text-[#567084]"></p><a class="submission-link mt-3 hidden items-center gap-2 text-sm font-bold text-[#3866a8]" target="_blank" rel="noopener noreferrer"><i data-lucide="external-link"></i><span data-template-id="submission-link-text" class="canva-link"></span></a>
    <p class="submission-score mt-3 text-sm font-bold text-[#6b4ca2]"></p>
    <div class="teacher-grade mt-4 hidden">
     <input class="score-input w-28 rounded-lg border border-[#d8c9f3] px-3 py-2" type="number" min="0" max="100"><button data-template-id="submission-score-button" class="canva-button save-score ml-2 rounded-lg bg-[#7651a8] px-3 py-2 text-sm font-bold text-white" type="button"></button>
    </div>
